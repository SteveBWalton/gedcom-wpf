<Window x:Class="gedcom.viewer.DialogSource"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gedcom.viewer"
        mc:Ignorable="d"
        Title="Edit Source" Height="450" Width="800" Loaded="windowLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <GroupBox Header="Source">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Type" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Title" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Date" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" Grid.Row="0" x:Name="_cboSourceType" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ComboBoxItem Content="General" />
                    <ComboBoxItem Content="Birth Certificate" />
                    <ComboBoxItem Content="Marriage Certificate" />
                    <ComboBoxItem Content="Death Certificate" />
                </ComboBox>
                <TextBox Grid.Column="1" Grid.Row="1" x:Name="_txtTitle" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBox x:Name="_txtDate" Width="100" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Button Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button.Content>
                            <Image Source="/Resources/16/calendar.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button.Content>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="2" Grid.Row="2" Text="Repository" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Grid.Column="3" Grid.Row="2" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ComboBoxItem Content="Steve Walton" />
                    <ComboBoxItem Content="Genes Reunited" />
                </ComboBox>
            </Grid>
        </GroupBox>
        <GroupBox Header="Special" Grid.Column="0" Grid.Row="1"></GroupBox>
        <GroupBox Header="Other Tags" Grid.Column="0" Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid x:Name="_gridTags">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </GroupBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3">
            <Button x:Name="buttonCancel" Margin="5" Padding="5" Click="buttonCancelClick" IsCancel="True" Width="100" Height="31">Cancel</Button>
            <Button x:Name="buttonOK" Margin="5" Padding="5" IsDefault="True" Click="buttonOkClick" Width="100" Height="31">OK</Button>
        </StackPanel>
        <Button Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="5" Width="100" Height="31" Click="addTagButtonClick" Content="Add Tag" Margin="10,0,0,0" />
    </Grid>
</Window>
