<Window x:Class="gedcom.viewer.DialogEditGedcom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gedcom.viewer"
        mc:Ignorable="d"
        Title="Edit Gedcom" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button x:Name="buttonCancel" Margin="5" Padding="5" Width="100" Height="31" Click="buttonCancelClick" IsCancel="True">Cancel</Button>
            <Button x:Name="buttonOK" Margin="5" Padding="5" Width="100" Height="31" IsDefault="False" Click="buttonOkClick">OK</Button>
        </StackPanel>
        <ScrollViewer Grid.Column="3" Grid.Row="4" Grid.RowSpan="8" BorderBrush="Black">
            <TextBox HorizontalAlignment="Stretch" x:Name="_statusTextBox" VerticalAlignment="Stretch" FontFamily="Courier New" AcceptsReturn="True" />
        </ScrollViewer>
    </DockPanel>
</Window>
