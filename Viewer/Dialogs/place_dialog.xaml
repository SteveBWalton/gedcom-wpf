<Window x:Class="gedcom.viewer.PlaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gedcom.viewer"
        mc:Ignorable="d"
        Title="Gedcom Place Value" Height="450" Width="600" Loaded="windowLoaded" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="_txtTagPlace" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Text="tagPlace" HorizontalAlignment="Center" VerticalAlignment="Center" Width="550" FontSize="16" FontWeight="Bold" TextAlignment="Center" LostFocus="txtTagDateLostFocus" />
        <TextBlock Grid.Column="0" Grid.Row="1" Text="Existing Places" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Button x:Name="_buttonParentExistingPlaces" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Click="buttonParentExistingPlacesClick" HorizontalAlignment="Left" >
            <Image Source="/Resources/16/arrow_blue_left.png" Width="16" Height="16" />
        </Button>
        <ComboBox x:Name="_cboExistingPlaces" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Margin="26,0,4,0" VerticalAlignment="Center" SelectionChanged="cboExistingPlacesSelectionChanged"/>
        <TextBlock Grid.Column="0" Grid.Row="2" Text="Address" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox x:Name="_txtAddress" Grid.Column="1" Grid.Row="2" Margin="2,0,0,0" Width="100" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <TextBlock Grid.Column="2" Grid.Row="2" Text="Country" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox x:Name="_country" Grid.Column="3" Grid.Row="2" Margin="2,0,0,0" Width="100" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <TextBlock Grid.Column="0" Grid.Row="3" Text="Latitude" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox x:Name="_txtLatitude" Grid.Column="1" Grid.Row="3" Margin="2,0,0,0" Width="100" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <TextBlock Grid.Column="2" Grid.Row="3" Text="Longitude" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox x:Name="_txtLongitude" Grid.Column="3" Grid.Row="3" Margin="2,0,0,0" Width="100" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <Button Grid.Row="4" Grid.Column="0" Content="Google Maps" Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center" Click="buttonGoogleMapsClick" />
        <StackPanel Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button x:Name="buttonCancel" Margin="5" Padding="5" Click="buttonCancelClick" IsCancel="True" Width="100" Height="31">Cancel</Button>
            <Button x:Name="buttonOK" Margin="5" Padding="5" IsDefault="True" Click="buttonOkClick" Width="100" Height="31">OK</Button>
        </StackPanel>
    </Grid>
</Window>
