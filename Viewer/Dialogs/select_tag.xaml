<Window x:Class="gedcom.viewer.DialogSelectTag"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gedcom.viewer"
        mc:Ignorable="d"
        Title="Select Tag" Height="350" Width="300" Loaded="windowLoaded" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.Row="0" x:Name="_labParentTagType" Text="TagType" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0" />
        <TextBlock Grid.Column="1" Grid.Row="0" x:Name="_labParentTagValue" Text="TagValue" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0" />
        <TextBlock Grid.Column="0" Grid.Row="1" Text="Tag" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" />
        <ListBox Grid.Column="1" Grid.Row="1" x:Name="_listSources"/>
        <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button x:Name="buttonCancel" Margin="5" Padding="5" Click="buttonCancelClick" IsCancel="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="31">Cancel</Button>
            <Button x:Name="buttonOK" Margin="5" Padding="5" IsDefault="True" Click="buttonOkClick" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="31">OK</Button>
        </StackPanel>

    </Grid>
</Window>
