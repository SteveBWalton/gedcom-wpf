<Window x:Class="gedcom.viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gedcom.viewer"
        mc:Ignorable="d"
        Icon="/tree_02.ico"
        Title="GedCom Viewer WPF" Height="450" Width="800" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Loaded="windowLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Menu Width="Auto" Height="20">
                <MenuItem Header="_File">
                    <MenuItem Header="New" Click="menuFileNewClick">
                        <MenuItem.Icon>
                            <Image Source="/Resources/file_new.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open..." Click="menuFileOpenClick">
                        <MenuItem.Icon>
                            <Image Source="/Resources/file_open.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save" Click="menuFileSaveClick"/>
                    <MenuItem Header="Save As..." Click="menuFileSaveAsClick"/>
                    <Separator />
                    <MenuItem x:Name="AppExit" Header="E_xit" HorizontalAlignment="Left" Width="140" Click="menuFileExitClick" >
                        <MenuItem.Icon>
                            <Image Source="/Resources/file_exit.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Edit..."  x:Name="_menuEditEdit" Click="menuEditEditClick">
                        <MenuItem.Icon>
                            <Image Source="/Resources/24/edit.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Edit Gedcom..." x:Name="_menuEditEditGedcom" Click="menuEditEditGedcomClick">
                        <MenuItem.Icon>
                            <Image Source="/Resources/24/textbox.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Add Individual..." Click="menuEditAddIndividualClick">
                        <MenuItem.Icon>
                            <Image Source="/Resources/16/person.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add Family..." Click="menuEditAddFamilyClick">
                        <MenuItem.Icon>
                            <Image Source="/Resources/16/people.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Options..."/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem x:Name="appTest" Header="Home" HorizontalAlignment="Left" Width="140" Click="menuViewHomeClick" >
                        <MenuItem.Icon>
                            <Image Source="/Resources/24/home.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem x:Name="About" Header="_About" HorizontalAlignment="Left" Width="140"/>
                </MenuItem>
            </Menu>
            <ToolBarTray>
                <ToolBar>
                    <Button Click="menuViewHomeClick">
                        <Image Source="/Resources/24/home.png" Height="24"/>
                    </Button>
                    <Button ToolTip="Start a new document." Click="menuFileNewClick">
                        <Image Source="/Resources/24/file_new.png" Height="24" />
                    </Button>
                    <Button ToolTip="Open a gedcom document." Click="menuFileOpenClick">
                        <Image Source="/Resources/24/file_open.png" Height="24"/>
                    </Button>
                    <Separator/>
                    <Button Click="menuEditEditClick" x:Name="_toolbarEdit">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/24/edit.png" Height="24" />
                            <TextBlock Margin="2,4,0,0">Edit</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="menuEditEditGedcomClick" x:Name="_toolbarEditGedom">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/24/textbox.png" Height="24" />
                            <TextBlock Margin="2,4,0,0">Edit Gedcom</TextBlock>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <Button Click="menuEditAddIndividualClick" ToolTip="Add individual.">
                        <Image Source="/Resources/24/person.png" Height="24" />
                    </Button>
                    <Separator/>
                    <Button>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/24/file_exit.png" Height="24"/>
                            <TextBlock Margin="2,4,0,0">Exit</TextBlock>
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </StackPanel>
        <WebBrowser x:Name="_webBrowser" Navigating="webBrowserNavigating" />
    </DockPanel>
</Window>
