<Window x:Class="gedcom.viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gedcom.viewer"
        mc:Ignorable="d"
        Icon="/tree_02.ico"
        Title="GedCom Viewer WPF" Height="450" Width="800" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Loaded="windowLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Menu Width="Auto" Height="20">
                <MenuItem Header="_File">
                    <MenuItem Header="New">
                        <MenuItem.Icon>
                            <Image Source="/Resources/file_new.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open..." Click="menuFileOpenClick">
                        <MenuItem.Icon>
                            <Image Source="/Resources/file_open.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="appTest" Header="Home" HorizontalAlignment="Left" Width="140" Click="appHomeClick" />
                    <MenuItem x:Name="AppExit" Header="E_xit" HorizontalAlignment="Left" Width="140" Click="appExitClick" >
                        <MenuItem.Icon>
                            <Image Source="/Resources/file_exit.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem x:Name="Options" Header="_Options" HorizontalAlignment="Left" Width="140"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem x:Name="About" Header="_About" HorizontalAlignment="Left" Width="140"/>
                </MenuItem>
            </Menu>
            <ToolBarTray>
                <ToolBar>
                    <Button ToolTip="Start a new document.">
                        <Image Source="/Resources/file_new.png" />
                    </Button>
                    <Button ToolTip="Open a gedcom document.">
                        <Image Source="/Resources/file_open.png" />
                    </Button>
                    <Button>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/file_exit.png" />
                            <TextBlock Margin="2,0,0,0">Exit</TextBlock>
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </StackPanel>
        <WebBrowser x:Name="_webBrowser" Navigating="webBrowserNavigating" />
    </DockPanel>
</Window>
